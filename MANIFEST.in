# Include documentation
include README.md
include LICENSE
include requirements.txt
include requirements-dev.txt

# Include documentation directory
recursive-include docs *.md

# Include grammar files
recursive-include lang *.tx

# Include template files
recursive-include generator *.template

# Include examples
recursive-include examples *.pg
recursive-include examples/assets *.md

# Include test fixtures
recursive-include tests/fixtures *.pg

# Exclude build artifacts
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.swp
global-exclude *.swo
