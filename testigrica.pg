game "Test igrica 12"

"Ovo je igrica platformemem la"

// NOTE: Replace asset paths with your own image files.
// Use relative paths: "assets/players/sprite.png"
// Or use color-based graphics: player { color blue height 80 width 40 }

player {
  image "assets/players/sprite.png"
  height 80
  width 40
}

boost Speed {
  color green
}

point one {
  color yellow
}

level Level1 {
  background image "assets/backgrounds/game_background1.jpg"
  platform {
    position 420 210
    texture image "assets/platforms/spring_rain.jpg"
    height 100
    width 370
  }
  boost Speed {
    position 120 150
  }
}

level Level2 {
  background image "assets/backgrounds/game_background2.jpg"
  platform {
    position 420 415
    height 100
    width 370
  }
}

settings {
  default texture color 'pink'
}
