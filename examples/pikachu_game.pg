game "Pokemon platformer"

"Pikachu jumping around"

// NOTE: Replace these asset paths with your own image files.
// Place your assets in the assets/ directory and use relative paths like:
// "assets/players/pikachu_default.png"
//
// Or use color-based graphics instead:
// player { color blue height 100 width 80 }

player {
  image "assets/players/pika_default.png"
  walk image "assets/players/pika_walking.png"
  idle image "assets/players/pika_idle.png"
  jump image "assets/players/pika_jump.png"
  height 100
  width 80
}

point nuggies {
  image "assets/items/nuggets_point.png"
}

level Level1 {
  background image "assets/backgrounds/game_background.jpg"
  platform {
    position 460 460
    texture image "assets/platforms/grass_texture.png"
    height 30
    width 80
  }
  platform {
    position 600 400
    texture image "assets/platforms/grass_texture.png"
    height 30
    width 80
  }
  platform {
    position 750 320
    texture image "assets/platforms/grass_texture.png"
    height 30
    width 80
  }
  platform {
    position 940 320
    texture image "assets/platforms/grass_texture.png"
    height 30
    width 80
  }
  platform {
    position 1200 320
    texture image "assets/platforms/grass_texture.png"
    height 30
    width 80
  }
  point nuggies {
    position 890 220
  }
}

settings {
  fps 55
}
